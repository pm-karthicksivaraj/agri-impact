# AgriImpact environment
# Copy this file to `.env` before running:  cp .env.example .env

# SQLite database location. Prisma resolves this path relative to prisma/schema.prisma,
# so this creates the database file at prisma/db/custom.db (verified behaviour).
DATABASE_URL="file:./db/custom.db"

# OPTIONAL — override the Open-Meteo base URL (e.g. a self-hosted proxy or mirror).
# Leave unset to use the free public API (default: https://api.open-meteo.com — no key needed).
# NOTE: Next.js inlines env values at BUILD time, so set this BEFORE `npm run build`
# (with `npm run dev` it is read at request time, so .env works directly).
# OPEN_METEO_BASE_URL="https://api.open-meteo.com"
